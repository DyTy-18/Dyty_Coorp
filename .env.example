# Número de WhatsApp en formato internacional, sin "+" ni espacios (ej. México: 5215512345678).
# Se incrusta en el build: en Dokploy agrégalo como Build Arg además de Environment.
NEXT_PUBLIC_WHATSAPP_NUMBER=5210000000000

# URL que recibe los leads del formulario en JSON (tu CRM, n8n, Make, etc.).
# Si está vacío, los leads solo se registran en los logs del contenedor.
LEAD_WEBHOOK_URL=
